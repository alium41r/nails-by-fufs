# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local scratch (audit/e2e harnesses, chrome profiles, logs)
/.b9/
/tmp-*

# next.js
/.next/
/out/

# production
/build

# prisma (derived layer: the generated client is a build artifact)
/src/generated/prisma

# misc
.DS_Store
# Private keys and certificates that may carry one. The pinned Supabase *root*
# CA under certs/ is a public trust anchor and is committed on purpose, so its
# extension is allowed through explicitly below.
*.pem
*.key
*.p12
!certs/*.crt

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vendored reference template (independently versioned: contains its own .git repo + remote)
/antigravity project template/
