generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model collections {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String     @unique
  title            String
  subtitle         String     @default("")
  description      String     @default("")
  tag              String?
  featured         Boolean    @default(false)
  display_order    Int?
  is_active        Boolean    @default(true)
  cover_image_path String?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
  products         products[]

  @@index([is_active], where: raw("(is_active = true)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_images {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String   @unique(map: "product_images_one_primary_per_product", where: raw("is_primary")) @db.Uuid
  storage_path String
  alt_text     String   @default("")
  sort_order   Int      @default(0)
  is_primary   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collection_id  String          @db.Uuid
  slug           String          @unique
  name           String
  descriptor     String          @default("")
  description    String          @default("")
  shape          String
  default_length String
  finish         String          @default("")
  tag            String?
  featured       Boolean         @default(false)
  display_order  Int?
  is_active      Boolean         @default(true)
  included       String[]        @default([])
  price_minor    Int?
  currency       String?         @db.Char(3)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  product_images product_images?
  collections    collections     @relation(fields: [collection_id], references: [id], onUpdate: NoAction)

  @@index([collection_id])
  @@index([is_active], where: raw("(is_active = true)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model custom_order_attachments {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id            String?                @db.Uuid
  submission_token      String                 @db.Uuid
  storage_path          String                 @unique
  original_filename     String
  content_type          String
  size_bytes            BigInt
  sort_order            Int                    @default(0)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  custom_order_requests custom_order_requests? @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([request_id])
  @@index([submission_token], map: "custom_order_attachments_token_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model custom_order_requests {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_token         String                     @unique @db.Uuid
  name                     String
  email                    String
  instagram                String?
  shape                    String
  length                   String
  sizing_preference        String
  standard_size            String?
  custom_measurements      String?
  color_palette            String?
  concept_description      String
  event_date               String?
  budget_guidance          String?
  additional_notes         String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  custom_order_attachments custom_order_attachments[]

  @@index([created_at(sort: Desc)])
}
