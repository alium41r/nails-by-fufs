generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model collections {
  id               String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String     @unique
  title            String
  subtitle         String     @default("")
  description      String     @default("")
  tag              String?
  featured         Boolean    @default(false)
  display_order    Int?
  is_active        Boolean    @default(true)
  cover_image_path String?
  created_at       DateTime   @default(now()) @db.Timestamptz(6)
  updated_at       DateTime   @default(now()) @db.Timestamptz(6)
  archived_at      DateTime?  @db.Timestamptz(6)
  archive_note     String?
  products         products[]

  @@index([is_active], where: raw("(is_active = true)"))
  @@index([archived_at(sort: Desc)], map: "collections_archived_idx", where: raw("(archived_at IS NOT NULL)"))
  @@index([display_order, slug], map: "collections_not_archived_idx", where: raw("(archived_at IS NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model product_images {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  product_id   String   @unique(map: "product_images_one_primary_per_product", where: raw("is_primary")) @db.Uuid
  storage_path String
  alt_text     String   @default("")
  sort_order   Int      @default(0)
  is_primary   Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  products     products @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model products {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  collection_id  String?         @db.Uuid
  slug           String          @unique
  name           String
  descriptor     String          @default("")
  description    String          @default("")
  shape          String
  default_length String
  finish         String          @default("")
  tag            String?
  featured       Boolean         @default(false)
  display_order  Int?
  is_active      Boolean         @default(true)
  included       String[]        @default([])
  price_minor    Int?
  currency       String?         @db.Char(3)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  updated_at     DateTime        @default(now()) @db.Timestamptz(6)
  archived_at    DateTime?       @db.Timestamptz(6)
  archive_note   String?
  order_items    order_items[]
  product_images product_images?
  collections    collections?    @relation(fields: [collection_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([collection_id])
  @@index([is_active], where: raw("(is_active = true)"))
  @@index([display_order, slug], map: "products_active_not_archived_idx", where: raw("(is_active AND (archived_at IS NULL))"))
  @@index([archived_at(sort: Desc)], map: "products_archived_idx", where: raw("(archived_at IS NOT NULL)"))
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model custom_order_attachments {
  id                    String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id            String?                @db.Uuid
  submission_token      String                 @db.Uuid
  storage_path          String                 @unique
  original_filename     String
  content_type          String
  size_bytes            BigInt
  sort_order            Int                    @default(0)
  created_at            DateTime               @default(now()) @db.Timestamptz(6)
  custom_order_requests custom_order_requests? @relation(fields: [request_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([request_id])
  @@index([submission_token], map: "custom_order_attachments_token_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model custom_order_requests {
  id                       String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submission_token         String                     @unique @db.Uuid
  name                     String
  email                    String
  instagram                String?
  shape                    String
  length                   String
  sizing_preference        String
  standard_size            String?
  custom_measurements      String?
  color_palette            String?
  concept_description      String
  event_date               String?
  budget_guidance          String?
  additional_notes         String?
  created_at               DateTime                   @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                   @default(now()) @db.Timestamptz(6)
  status                   String                     @default("pending_review")
  status_updated_at        DateTime?                  @db.Timestamptz(6)
  admin_note               String?
  custom_order_attachments custom_order_attachments[]

  @@index([created_at(sort: Desc)])
  @@index([status, created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model order_items {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id            String    @db.Uuid
  product_id          String?   @db.Uuid
  product_slug        String
  product_name        String
  product_descriptor  String
  product_shape       String
  product_finish      String
  collection_slug     String
  selected_size       String
  selected_size_label String
  selected_length     String
  unit_price_minor    Int
  currency            String    @db.Char(3)
  quantity            Int
  line_total_minor    Int
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  orders              orders    @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  products            products? @relation(fields: [product_id], references: [id], onUpdate: NoAction)

  @@index([order_id])
  @@index([product_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model orders {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_token    String        @unique @db.Uuid
  currency       String        @db.Char(3)
  subtotal_minor Int
  total_minor    Int
  status         String        @default("pending_payment")
  created_at     DateTime      @default(now()) @db.Timestamptz(6)
  updated_at     DateTime      @default(now()) @db.Timestamptz(6)
  order_items    order_items[]

  @@index([created_at(sort: Desc)])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appointment_requests {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_token     String    @unique @db.Uuid
  name              String
  phone             String
  email             String?
  service_type      String
  preferred_date    DateTime  @db.Date
  preferred_time    String
  alternate_date    DateTime? @db.Date
  set_details       String?
  notes             String?
  status            String    @default("pending_review")
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @db.Timestamptz(6)
  status_updated_at DateTime? @db.Timestamptz(6)
  admin_note        String?

  @@unique([preferred_date, preferred_time], map: "appointment_requests_confirmed_slot_key", where: raw("(status = 'confirmed'::text)"))
  @@index([status, created_at(sort: Desc)])
}

